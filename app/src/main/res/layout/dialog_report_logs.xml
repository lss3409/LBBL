<?xml version="1.0" encoding="utf-8"?>
<!-- v0.4.29：上报日志弹窗 UI（描述输入 + 说明文案） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misans"
        android:text="@string/report_desc_sub"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/report_desc_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_box"
        android:fontFamily="@font/misans"
        android:gravity="top"
        android:hint="@string/report_crash_desc_hint"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:padding="12dp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/misans"
        android:text="@string/report_logs_desc"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
