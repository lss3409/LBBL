<?xml version="1.0" encoding="utf-8"?>
<!-- v0.4.10：光标白色光晕（径向渐变：中心亮白 → 边缘透明）。
     参考主流手柄 UI 的鼠标光标设计——白色发光圈提升任何背景下的
     可见度（箭头本身白+黑描边，光晕再补一层亮度） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="26dp"
        android:startColor="#90FFFFFF"
        android:centerColor="#38FFFFFF"
        android:endColor="#00FFFFFF" />
</shape>
